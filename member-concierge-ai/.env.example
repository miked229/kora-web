# ─────────────────────────────────────────────────────────────
# Member Concierge AI — Variables de entorno (ejemplo)
# Copia este archivo a `.env.local` y rellena los valores reales.
# NUNCA subas `.env.local` al repositorio.
# ─────────────────────────────────────────────────────────────

# --- Aplicación ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Solo en el servidor. Acceso total que ignora RLS. Mantener en secreto.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Autenticación de socios ---
# Secreto para firmar la sesión por número de membresía (JWT/HMAC).
MEMBERSHIP_SESSION_SECRET=genera-un-secreto-largo-aleatorio

# --- WhatsApp Business Cloud API ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=token-de-verificacion-webhook
# App Secret de la app de Meta (firma de webhooks X-Hub-Signature-256).
WHATSAPP_APP_SECRET=

# --- Gmail API (cuenta de soporte) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SUPPORT_ADDRESS=soporte@koramx.com

# --- n8n (automatizaciones) ---
N8N_WEBHOOK_URL=https://n8n.tu-dominio.com/webhook
# Secreto compartido para validar llamadas entrantes desde n8n.
N8N_WEBHOOK_SECRET=secreto-compartido-n8n
