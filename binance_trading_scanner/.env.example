# ============================================================================
# Binance Trading Scanner Pro — Environment Example
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
# API credentials are ONLY needed for authenticated modes (Binance Demo /
# Testnet). Public market data (Phase 1) requires NO credentials.
# Secrets are never logged, never shown in the dashboard, never stored in the
# database.
# ============================================================================

# ---- Binance API credentials (OPTIONAL — leave blank for public data only) --
# Needed ONLY for Binance Spot TESTNET orders (fake money). Get testnet keys at
# https://testnet.binance.vision . The trading key must have READ + SPOT TRADING
# and MUST NOT have WITHDRAWAL permission. Add an IP restriction if possible.
# Credentials are read from the environment only — never hardcoded, logged,
# shown in the UI, stored in SQLite, or committed to Git.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- Environment selection --------------------------------------------------
# "mainnet"  -> public production REST/WS (read-only market data)
# "testnet"  -> Binance Spot Testnet (https://testnet.binance.vision)
BINANCE_ENV=mainnet

# ---- Execution safety (all default to the SAFEST setting) -------------------
# Kill switch: TRADING_DISABLED (default) | TRADING_TESTNET  (LIVE is not
# selectable here). Orders are only ever sent on TRADING_TESTNET.
TRADING_STATE=TRADING_DISABLED
# LIVE trading is a FUTURE phase. It requires BOTH of these to be "true" AND a
# manual confirmation in the UI — and even then this build ships no mainnet
# order client, so real orders cannot be placed. Leave both blank/false.
TRADING_LIVE=false
ENABLE_LIVE_CONFIRMATION=false
# Order safety caps
SYMBOL_WHITELIST=BTCUSDT,ETHUSDT
MAX_ORDER_NOTIONAL=1000
MAX_LIVE_CAPITAL=0

# Public REST base. If your network blocks api.binance.com you can point this
# at the official market-data mirror: https://data-api.binance.vision
BINANCE_REST_BASE=https://api.binance.com

# ---- Application defaults (all overridable from the Settings page) ----------
# Trading mode: BACKTEST | PAPER | BINANCE_DEMO | LIVE_DISABLED
APP_MODE=PAPER

# Account capital used for risk / position sizing (quote currency, e.g. USDT)
CAPITAL=10000

# Fraction of capital risked per trade (0.01 = 1%)
RISK_PER_TRADE=0.01

# Backtest cost assumptions (Binance Spot taker fee default is 0.001 = 0.10%)
FEE_RATE=0.001
SLIPPAGE_RATE=0.0005

# ---- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ---- Local storage ----------------------------------------------------------
DB_PATH=data/scanner.db
